# Port the Express server listens on
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/airbnb-clone?retryWrites=true&w=majority

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins for CORS
CLIENT_URLS=http://localhost:3000,http://localhost:3001
